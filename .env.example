# MongoDB Atlas or local MongoDB connection string
MONGODB_URI=mongodb://127.0.0.1:27017/jagruk-bharat

# Firebase client configuration (safe to expose in the browser; copy from Firebase Web app settings)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=jagruk-bharat-37311.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin configuration (private; copy from a Firebase service-account JSON key)
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# Optional Vercel Blob fallback. Cloudinary is used when its three variables are configured.
BLOB_READ_WRITE_TOKEN=

# Use a long random value; it protects the automated hazard-expiry endpoint.
CRON_SECRET=

# Optional infrastructure. Docker provides local Redis automatically.
REDIS_URL=

# Cloudinary object storage for evidence photos.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Error reporting and trace export. Both stay disabled when blank.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
OTEL_EXPORTER_OTLP_ENDPOINT=
