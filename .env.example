# MongoDB Atlas or local MongoDB connection string
MONGODB_URI=mongodb://127.0.0.1:27017/jagruk-bharat

# Firebase client configuration (safe to expose in the browser; copy from Firebase Web app settings)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=jagruk-bharat-37311.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin configuration (private; copy from a Firebase service-account JSON key)
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# Required for cloud photo uploads in production. Create a Blob store in your Vercel project.
BLOB_READ_WRITE_TOKEN=

# Use a long random value; it protects the automated hazard-expiry endpoint.
CRON_SECRET=

# Optional production infrastructure. Docker provides local Redis and MinIO defaults.
REDIS_URL=
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
